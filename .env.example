# Database connection string (SQLite local-first)
DATABASE_URL="file:./dev.db"

# Session JWT secret (32+ character random string for signing cookies)
SESSION_SECRET="change-this-to-a-secure-random-string-at-least-32-characters-long"

# App configuration
NEXT_PUBLIC_APP_NAME="PaisaPilot"
NEXT_PUBLIC_APP_DESCRIPTION="Personal Finance Manager"

# Resend OTP Email Service (Free tier: 3,000 emails/month at https://resend.com)
# Optional in development: if omitted, OTP codes are logged directly to the server console!
RESEND_API_KEY=""
RESEND_FROM_EMAIL="PaisaPilot <onboarding@resend.dev>"
